describe('Klodr Platform - Automated Smoke Suite', () => {
  const loginEmail = 'klodr.2026+dev-salon-owner@gmail.com';
  const loginPassword = 'Testtenant@1';

  // Prevent uncaught application exceptions from breaking test runs
  Cypress.on('uncaught:exception', () => false);

  it('should complete smoke flow: Login -> Dashboard -> Open Customers -> Add Customer -> Logout', () => {
    // -------------------------------------------------------------------------
    // STEP 1: LOG IN
    // -------------------------------------------------------------------------
    cy.visit('https://dev-one.klodr.com/login');

    // Fill login credentials
    cy.get('input[type="email"]', { timeout: 10000 })
      .should('be.visible')
      .clear()
      .type(loginEmail);

    cy.get('input[type="password"]', { timeout: 10000 })
      .should('be.visible')
      .clear()
      .type(loginPassword);

    cy.get('button[type="submit"]').click();

    // Confirm login redirection away from /login page
    cy.url({ timeout: 15000 }).should('not.include', '/login');

    // -------------------------------------------------------------------------
    // STEP 2: DASHBOARD LOAD
    // -------------------------------------------------------------------------
    cy.get('header', { timeout: 10000 }).should('be.visible');
    cy.contains('Welcome back', { timeout: 10000 }).should('be.visible');

    // -------------------------------------------------------------------------
    // STEP 3: NAVIGATE TO SALON & CUSTOMERS
    // -------------------------------------------------------------------------
    // Open the sidebar menu
    cy.get('#root svg.lucide-menu').click();

    // Expand the 'Salon' dropdown section in the sidebar
    cy.get('#root aside.absolute div:nth-child(2) button.flex').click();

    // Click on the 'Customers' link
    cy.get('#root aside.absolute a[href="/salon/customers"] span.truncate').click();

    // Verify Customer Page Load
    cy.url({ timeout: 10000 }).should('include', '/salon/customers');
    cy.get('#root h1.font-semibold').should('contain.text', 'Customers');

    // -------------------------------------------------------------------------
    // STEP 4: ADD A NEW CUSTOMER
    // -------------------------------------------------------------------------
    // Open 'New customer' Modal
    cy.get('#root button.bg-accent').click();
    cy.get('h2.font-semibold').should('contain.text', 'New customer');

    // Fill Out Customer Form
    cy.get('#customer-form input.pl-9').type('8654321789');
    cy.get('#customer-form input[maxlength="50"]').type('Raju');

    // Submit Form
    cy.get('button[type="submit"]').click();

    // Verify Success & Table Updates
    cy.get('div.bg-surface-raised').should('be.visible'); // Success toast/message
    cy.get('#root div.border-t.flex').should('contain.text', 'shown');

    // -------------------------------------------------------------------------
    // STEP 5: LOG OUT
    // -------------------------------------------------------------------------
    // 1. Open the user menu (grabs the last button in the header)
    cy.get('header button').last().click();

    // 2. Click Log out
    cy.contains('Log out').click();

    // 3. Verify session terminated and user returned to login screen
    cy.url({ timeout: 10000 }).should('include', '/login');
  });
});
